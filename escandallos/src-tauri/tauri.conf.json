{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "con-sazon-gestion",
  "version": "0.9.1",
  "identifier": "com.campillo.con-sazon-gestion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Con Sazón_gestión",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Campillo-Code/escandallosApp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NjU4OEEwREYxRTlCNjQKUldSa214N2ZvSWhsK1JFaW9VSzV3cWZucUVkZTZFNlhuYXdpdlZkK1hvZXg5aTFlT2FTTWV6K0EK",
      "dialog": true
    }
  }
}
